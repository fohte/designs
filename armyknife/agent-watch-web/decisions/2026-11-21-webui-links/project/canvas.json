  "notes": {
    "current": {
      "kind": "title1",
      "x": 0,
      "y": -260,
      "maxW": 1910,
      "page": "mark",
      "text": "今の画面 · web UI の URL も、ふつうのリンクと同じく新しいブラウザのタブで開く"
    },
    "currentNote": {
      "x": 1990,
      "y": 0,
      "w": 520,
      "page": "mark",
      "text": "前提\n- 会話の中のリンクの URL が、登録済みの web UI (a agent web-ui add) の URL なら、押すとそのセッションの状況パネルの web UI タブで開く\n- 例の web UI は canvas。URL はページ指定つき (#page-options) の架空の値\n- 例のメッセージには web UI のリンク「案のページ」と、ふつうのリンク「設計メモ」を並べた\n- 問いは 3 つで、ページごとに分けた: 見分け方 / 押したときの動き / 新しいタブで開く手段。どの問いの案も、ほかの問いの案と組み合わせられる\n- データはすべて架空"
    },
    "markNone": {
      "kind": "title1",
      "x": 0,
      "y": 1020,
      "maxW": 1910,
      "page": "mark",
      "text": "見分けない · web UI のリンクもふつうのリンクと同じ見た目"
    },
    "markNoneNote": {
      "x": 1990,
      "y": 1280,
      "w": 460,
      "page": "mark",
      "text": "見分けない\n+ 足すものがなく、会話の見た目が今と変わらない\n- 押すまで、どこで開くか分からない。新しいタブを期待して押すと、パネルが開いて驚く\n- 設計メモのようなふつうのリンクと区別できない"
    },
    "markIcon": {
      "kind": "title1",
      "x": 0,
      "y": 2300,
      "maxW": 1910,
      "page": "mark",
      "text": "パネルのアイコンを付ける · リンクの後ろに状況パネルの形を出す"
    },
    "markIconNote": {
      "x": 1990,
      "y": 2560,
      "w": 460,
      "page": "mark",
      "text": "パネルのアイコンを付ける\n+ 小さく、文の流れをほとんど崩さない\n+ ヘッダーの状況パネルのボタンと同じ形で、パネルで開くと結びつく\n- どの web UI のタブで開くかは分からない。crit と canvas のように web UI が複数あると区別できない\n- 形の意味は、覚えるまで伝わりにくい\n\nweb UI の名前を添える案と重ねられる (その案はアイコンも含む)"
    },
    "markName": {
      "kind": "title1",
      "x": 0,
      "y": 3580,
      "maxW": 1910,
      "page": "mark",
      "text": "web UI の名前を添える · リンクの後ろに開く先のタブ名を出す"
    },
    "markNameNote": {
      "x": 1990,
      "y": 3840,
      "w": 460,
      "page": "mark",
      "text": "web UI の名前を添える\n+ 開く先のタブ名が出るので、どのリンクがどのタブに行くか分かる。「どれがどれかわからない」に直接効く\n+ web UI が複数あっても区別できる\n- 文の中の文字が増え、リンクが多いメッセージは騒がしくなる\n- 名前の長い web UI だと行が折り返しやすい"
    },
    "markRec": {
      "x": 1990,
      "y": 4500,
      "w": 460,
      "fill": "green",
      "page": "mark",
      "text": "推奨 · web UI の名前を添える\nユーザーの困りごとは「どれがどれか」なので、開く先の名前まで見せる。ほかのページの画面もこの見た目で描いた"
    },
    "openPanel": {
      "kind": "title1",
      "x": 0,
      "y": -260,
      "maxW": 1910,
      "page": "open",
      "text": "状況パネルで開く · パネルを開いて web UI のタブを選び、その URL を読み込む"
    },
    "openPanelNote": {
      "x": 1990,
      "y": 0,
      "w": 460,
      "page": "open",
      "text": "状況パネルで開く\n- PC: パネルが閉じていれば開く。開いていれば web UI のタブに切り替えるだけ\n- iPhone: 状況パネルのページを web UI のタブで開く。戻ると会話の同じ位置に戻る\n+ PC では会話を読みながら確かめられる\n+ 今の状況パネルと web UI タブをそのまま使い、新しい画面がない\n+ 広く見たいときは今の ⛶ で全画面にできる\n- PC のパネル幅では canvas が窮屈\n- タブで開いていたページは置き換わる"
    },
    "openRec": {
      "x": 1990,
      "y": 640,
      "w": 460,
      "fill": "green",
      "page": "open",
      "text": "推奨 · 状況パネルで開く\n会話と並べて見られ、新しい画面を足さない。全画面は今ある ⛶ に任せる"
    },
    "openFull": {
      "kind": "title1",
      "x": 0,
      "y": 1020,
      "maxW": 1910,
      "page": "open",
      "text": "web UI を全画面で開く · web UI だけを画面いっぱいに出す"
    },
    "openFullNote": {
      "x": 1990,
      "y": 1280,
      "w": 460,
      "page": "open",
      "text": "web UI を全画面で開く\n- PC: web UI の ⛶ と同じ全画面で開く。↙ で状況パネルの中に戻り、× で閉じる\n- iPhone: タブのない web UI だけのページを重ねる。戻るで会話へ\n+ canvas を広く見られる\n- 会話が隠れ、読みながら比べられない\n- PC では押すたびに画面全体が切り替わる\n- iPhone はほかのタブに移るには一度戻る"
    },
    "newtabAbout": {
      "x": 2530,
      "y": 0,
      "w": 460,
      "page": "newtab",
      "text": "このページの画面\n- どの案でも、ふつうのクリック / タップは押したときの動きのページのとおり web UI タブで開く\n- web UI のヘッダーの URL (PC) と ↗ (iPhone) は今もあるので、どの案を選んでも残る"
    },
    "newtabHeader": {
      "kind": "title1",
      "x": 0,
      "y": -260,
      "maxW": 1910,
      "page": "newtab",
      "text": "web UI のヘッダーから開く · リンクは変えず、開いた後のヘッダーから新しいタブへ"
    },
    "newtabHeaderNote": {
      "x": 1990,
      "y": 0,
      "w": 460,
      "page": "newtab",
      "text": "web UI のヘッダーから開く\n- PC: ヘッダーの URL を押す。iPhone: ヘッダーの ↗ を押す\n+ 何も足さない。今あるものだけで済む\n- 一度パネルで開いてからでないと新しいタブにできない。読み込みが 2 回になる\n- 会話のリンクから直接は開けない"
    },
    "newtabModifier": {
      "kind": "title1",
      "x": 0,
      "y": 1020,
      "maxW": 1910,
      "page": "newtab",
      "text": "⌘ クリック・長押しで開く · PC は ⌘ クリック、iPhone は長押しのシートから"
    },
    "newtabModifierNote": {
      "x": 1990,
      "y": 1280,
      "w": 460,
      "page": "newtab",
      "text": "⌘ クリック・長押しで開く\n- PC: ホバーのツールチップで ⌘ クリックを知らせる\n- iPhone: 長押しでシートを出し、web UI タブ / 新しいタブ / Copy link を選ぶ\n+ PC はブラウザの約束どおり。href を本物の URL にしておけば ⌘ クリックと中クリックがそのまま効く\n+ ふつうのクリックの動きも見た目も変えない\n- 知らないと気づけない。PC はツールチップ頼み\n- iPhone は OS の長押しメニューを止めて、アプリのシートを出す必要がある"
    },
    "newtabRec": {
      "x": 1990,
      "y": 1920,
      "w": 460,
      "fill": "green",
      "page": "newtab",
      "text": "推奨 · ⌘ クリック・長押しで開く\n会話の見た目を増やさず、会話のリンクから直接新しいタブにできる。web UI のヘッダーから開く手段も残るので組み合わせになる"
    },
    "newtabButton": {
